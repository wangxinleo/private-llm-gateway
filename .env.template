# Privacy Proxy Environment Configuration
# Copy this to .env only for direct npm runs. docker-compose.yaml keeps its
# essential startup values inline so deployments can edit that file directly.
# Never commit .env with secrets.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
DEBUG=false

# Optional default upstream. When set, requests without a channel prefix fall back to it
# (legacy single-upstream mode). When empty, unmatched paths return 404 — configure
# channels (with random prefixes) in the dashboard and route via /<channel>/...
UPSTREAM_URL=http://localhost:8787

# SQLite audit database path for direct npm runs.
DB_PATH=audit.sqlite

# Admin key required to access /dashboard management console.
# Generate a strong random key: openssl rand -base64 32
ADMIN_KEY=

# Optional: fixed placeholder-derivation secret (>=16 chars). When set, placeholder
# mappings stay identical across restarts and replicas, preserving upstream prompt-cache
# prefixes. When unset, a random secret is generated per process (only costs one cache miss).
# Generate: openssl rand -hex 32
# PRIVACY_SUFFIX_SECRET=
